---
import Layout from '../layouts/Layout.astro';
import { profile, toolkit, work } from '../data/portfolio';
---
<Layout title="resume — Mostafa Asadi">
  <main id="main" class="resume-page container">
    <div class="resume-toolbar"><a class="text-link" href={import.meta.env.BASE_URL}>← Back to portfolio</a><button class="button button-primary" id="print-resume">Print / Save as PDF <span aria-hidden="true">↗</span></button></div>
    <header class="resume-header"><p class="section-index mono">resume / MOSTAFA ASADI</p><h1>Mostafa Asadi</h1><p class="resume-role">Senior Frontend Engineer</p><a href={`mailto:${profile.email}`}>{profile.email}</a><div class="resume-socials"><a href={profile.github}>github.com/MostafaAsadi3</a><a href={profile.linkedin}>LinkedIn</a></div></header>
    <section><h2>Profile</h2><p>Senior frontend developer with a B.Sc. in Computer Engineering (Software), experienced in enterprise single-page applications using React, Next.js, and TypeScript. Focused on modular component architecture, state management, performance optimization, and maintainable code. Experienced in collaboration with backend teams in Agile and Scrum environments.</p></section>
    <section><h2>Core expertise</h2><p>Component-driven architecture; Redux Toolkit, React Query, and Zustand; lazy loading and code splitting; Jest and unit testing; responsive interface development; SSR, SSG, ISR, and server actions in Next.js; REST, GraphQL, and WebSocket integration; Git Flow, Docker, and CI/CD.</p><div class="resume-toolkit">{toolkit.map(group => <p><strong>{group.label}:</strong> {group.items.join(', ')}</p>)}</div></section>
    <section><h2>Experience</h2><article><div class="resume-job"><h3>Senior Front-End Developer</h3><span>2026–Present</span></div><p class="resume-company">Omid Intelligent IT Analysts</p></article><article><div class="resume-job"><h3>Front-End Developer</h3><span>2024–2026</span></div><p class="resume-company">Sakkook (Tosan)</p><p>Worked on the Tosan supply chain finance (SCF) project for electronic promissory notes and bills of exchange. Developed banking and user content management applications using React and TypeScript, with Tailwind CSS and Material UI. Collaborated with backend colleagues on UI/UX improvements, modern frontend architecture, clean code, and application performance.</p></article><article><div class="resume-job"><h3>Freelance Front-End Developer</h3><span>2024</span></div><p class="resume-company">Project-based · Remote</p></article><article><div class="resume-job"><h3>Front-End Developer</h3><span>2023–2024</span></div><p class="resume-company">Tuka</p></article></section>
    <section><h2>Selected projects</h2>{work.map(project => <article><h3>{project.title} — {project.subtitle}</h3><p>{project.description} {project.contribution}</p><p><strong>Tech stack:</strong> {project.stack.join(', ')}.</p>{project.implementation.map(detail => <p><strong>{detail.label}:</strong> {detail.text}</p>)}</article>)}</section>
    <section><h2>Education & language</h2><p><strong>B.Sc. in Computer Engineering — Software</strong><br />Islamic Azad University, Tehran North Branch · 2013–2017</p><p>English — Advanced</p></section>
  </main>
  <script>document.getElementById('print-resume')?.addEventListener('click', () => window.print());</script>
</Layout>

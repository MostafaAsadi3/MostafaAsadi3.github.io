---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import '../styles/refinement.css';
import { profile } from '../data/portfolio';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = `${profile.name} | ${profile.title}, React & Next.js`, description = profile.description, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base.replace(/\/$/, '')}/${path}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const home = new URL(base, Astro.site!);
const isHome = canonical?.pathname === home.pathname;
const socialImage = new URL(asset('social-card.png'), Astro.site!);
const personId = `${home.href}#person`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person', '@id': personId, name: profile.name,
      url: home.href, jobTitle: profile.title,
      description: profile.description,
      sameAs: [profile.github, profile.linkedin],
      knowsAbout: ['Frontend architecture', 'React', 'Next.js', 'TypeScript', 'Web accessibility', 'Banking applications'],
    },
    {
      '@type': 'WebSite', '@id': `${home.href}#website`, url: home.href,
      name: `${profile.name} — Portfolio`, inLanguage: 'en', author: { '@id': personId },
    },
    {
      '@type': 'WebPage', '@id': canonical?.href, url: canonical?.href,
      name: title, description, inLanguage: 'en',
      isPartOf: { '@id': `${home.href}#website` }, about: { '@id': personId },
      ...(isHome ? { mainEntity: { '@id': personId } } : {}),
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111214" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    {!noindex && canonical && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" type="application/xml" href={asset('sitemap.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content={`${profile.name} — Portfolio`} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mostafa Asadi — Senior Frontend Engineer. React, Next.js and TypeScript." />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Mostafa Asadi — Senior Frontend Engineer" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/interactions';
    </script>
  </body>
</html>
